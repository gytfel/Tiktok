#!/usr/bin/env bash
# Управление TikTok Studio на сервере. Справка: sudo tiktok-studio help
set -euo pipefail

APP_DIR=/opt/tiktok-studio/app
VENV=/opt/tiktok-studio/venv
DATA_DIR="${TS_DATA_DIR:-/var/lib/tiktok-studio}"
SERVICE_USER=tiktokstudio
PORT=8765
INSTALLER="https://raw.githubusercontent.com/${TS_REPO:-gytfel/Tiktok}/${TS_BRANCH:-main}/deploy/install.sh"
MARK="Нужен код доступа"  # так отвечает только студия — по этой фразе видно, что по ссылке именно она

die() { printf 'Ошибка: %s\n' "$*" >&2; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "нужны права администратора: sudo tiktok-studio $*"; }

py() {
  (cd "$APP_DIR" && umask 077 && runuser -u "$SERVICE_USER" -- env HOME="$DATA_DIR" TIKTOK_STUDIO_WORKSPACE="$DATA_DIR" "$VENV/bin/python" "$@")
}

studio_url() { sed -n 's/^STUDIO_URL=//p' "$DATA_DIR/server.env" 2>/dev/null | head -1; }

# Что отвечает по адресу: studio (студия, HTTPS в порядке), nocert (студия, но сертификата
# ещё нет), other (другая программа) или none (не отвечает).
url_state() {
  if curl -s --max-time 8 "$1/api/status" 2>/dev/null | grep -q "$MARK"; then echo studio; return; fi
  if curl -sk --max-time 8 "$1/api/status" 2>/dev/null | grep -q "$MARK"; then echo nocert; return; fi
  if [ "$(curl -sk -o /dev/null -w '%{http_code}' --max-time 8 "$1/" 2>/dev/null || true)" != "000" ]; then
    echo other
  else
    echo none
  fi
}

# ------------------------------------------------------------------ порты 80 и 443
# Их проверяет и освобождает установщик (tiktok-studio ports / free-ports) и doctor.

port_pids() {
  ss -Hltnp "sport = :$1" 2>/dev/null | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -un || true
}
comm_of() { cat "/proc/$1/comm" 2>/dev/null || echo "?"; }
ppid_of() { awk '/^PPid:/ {print $2}' "/proc/$1/status" 2>/dev/null || true; }

# Главный процесс программы: поднимаемся по родителям с тем же именем (nginx: worker → master).
top_pid() {
  local pid=$1 parent
  parent="$(ppid_of "$pid")"
  while [ -n "$parent" ] && [ "$parent" -gt 1 ] && [ "$(comm_of "$parent")" = "$(comm_of "$pid")" ]; do
    pid=$parent
    parent="$(ppid_of "$pid")"
  done
  echo "$pid"
}

# Цепочка родителей — видно, кто перезапускает программу: «nginx ← supervisord ← systemd».
chain_of() {
  local pid=$1 out n=0
  out="$(comm_of "$pid")"
  pid="$(ppid_of "$pid")"
  while [ -n "$pid" ] && [ "$pid" -gt 0 ] && [ "$n" -lt 4 ]; do
    out="$out ← $(comm_of "$pid")"
    pid="$(ppid_of "$pid")"
    n=$((n + 1))
  done
  echo "$out"
}

# Docker-контейнеры, опубликовавшие порт на сервере (их слушает docker-proxy).
containers_on_port() {
  local id
  command -v docker >/dev/null 2>&1 || return 0
  for id in $(docker ps -q 2>/dev/null); do
    if docker port "$id" 2>/dev/null | grep -qE ":$1\$"; then echo "$id"; fi
  done
}

# Службы systemd и их главные процессы: строки «pid служба».
service_pids() {
  [ -d /run/systemd/system ] || return 0
  systemctl show '*.service' -p MainPID -p Id 2>/dev/null | awk 'BEGIN { RS = "" } {
    m = ""; u = ""; n = split($0, l, "\n")
    for (i = 1; i <= n; i++) { if (l[i] ~ /^MainPID=/) m = substr(l[i], 9); if (l[i] ~ /^Id=/) u = substr(l[i], 4) }
    if (m + 0 > 1) print m, u }' || true
}

# Кто управляет процессом: «docker ID», «podman ID», «service ИМЯ» или «process PID».
owner_of() {
  local pid cg id cpid p units unit
  pid="$(top_pid "$1")"
  cg="$(cat "/proc/$pid/cgroup" 2>/dev/null || true)"
  id="$(grep -oE '(docker|libpod)[-/][0-9a-f]{12,64}' <<<"$cg" | grep -oE '[0-9a-f]{12,64}$' | head -1 || true)"
  if [ -n "$id" ]; then
    case "$cg" in *libpod*) echo "podman $id" ;; *) echo "docker $id" ;; esac
    return
  fi
  if command -v docker >/dev/null 2>&1; then  # контейнер, чей главный процесс — этот или его родитель
    for id in $(docker ps -q 2>/dev/null); do
      cpid="$(docker inspect -f '{{.State.Pid}}' "$id" 2>/dev/null || true)"
      p=$pid
      while [ -n "$p" ] && [ "$p" -gt 1 ]; do
        if [ "$p" = "$cpid" ]; then echo "docker $id"; return; fi
        p="$(ppid_of "$p")"
      done
    done
  fi
  if ! grep -q 'user@' <<<"$cg"; then
    unit="$(grep -oE '[^/]+\.service$' <<<"$cg" | head -1 || true)"
    if [ -n "$unit" ]; then echo "service $unit"; return; fi
  fi
  units="$(service_pids)"  # служба, у которой этот процесс или его родитель — главный
  p=$pid
  while [ -n "$p" ] && [ "$p" -gt 1 ]; do
    unit="$(awk -v p="$p" '$1 == p { print $2; exit }' <<<"$units")"
    if [ -n "$unit" ]; then echo "service $unit"; return; fi
    p="$(ppid_of "$p")"
  done
  echo "process $pid"
}

describe_owner() {
  local kind=${1%% *} id=${1#* } name
  case "$kind" in
    docker)
      name="$(docker inspect -f '{{.Name}}' "$id" 2>/dev/null || true)"
      echo "Docker-контейнер ${name#/}" ;;
    podman) echo "контейнер Podman ${id:0:12}" ;;
    service) echo "служба $id" ;;
    *) echo "процесс $id: $(chain_of "$id")" ;;
  esac
}

# Чужие программы на портах: строки «порт|программа|владелец» (Caddy студии не в счёт).
port_holders() {
  local port pid name id
  for port in 80 443; do
    for pid in $(port_pids "$port"); do
      name="$(comm_of "$pid")"
      [ "$name" = caddy ] && continue
      if [ "$name" = docker-proxy ]; then
        for id in $(containers_on_port "$port"); do echo "$port|$name|docker $id"; done
        continue
      fi
      echo "$port|$name|$(owner_of "$pid")"
    done
  done | sort -u
}

ports_report() {
  local port name owner
  while IFS='|' read -r port name owner; do
    if [ -n "$port" ]; then printf '  порт %s: %s (%s)\n' "$port" "$name" "$(describe_owner "$owner")"; fi
  done <<< "$(port_holders)"
}

free_ports() {
  local owners owner kind id name waited
  owners="$(port_holders | cut -d'|' -f3 | sort -u)"
  [ -n "$owners" ] || return 0
  while read -r owner; do
    kind=${owner%% *}
    id=${owner#* }
    case "$kind" in
      docker)
        docker update --restart=no "$id" >/dev/null 2>&1 || true
        docker stop "$id" >/dev/null && echo "Остановил $(describe_owner "$owner") и отключил его автозапуск." ;;
      podman) podman stop "$id" >/dev/null && echo "Остановил $(describe_owner "$owner")." ;;
      service)
        case "$id" in
          docker.service|containerd.service|ssh.service|sshd.service) echo "Не трогаю системную службу $id." ;;
          *) systemctl disable --now "$id" >/dev/null 2>&1 || systemctl stop "$id"
             echo "Остановил и отключил службу $id." ;;
        esac ;;
      *)
        name="$(comm_of "$id")"
        kill "$id" 2>/dev/null || true
        for _ in 1 2 3; do kill -0 "$id" 2>/dev/null || break; sleep 1; done
        kill -9 "$id" 2>/dev/null || true
        echo "Остановил процесс $id ($name)." ;;
    esac
  done <<< "$owners"
  # Даём время: если программу кто-то перезапускает, она снова займёт порт — это и проверим.
  for waited in 1 2 3 4 5; do
    [ -n "$(port_holders)" ] || return 0
    sleep "$waited"
  done
}

info() {
  local url key
  url="$(studio_url)"
  [ -n "$url" ] || die "студия не установлена (нет $DATA_DIR/server.env)"
  key="$(py -c 'from studio import phone; print(phone.access_key())')"
  case "$(url_state "$url")" in
    other) printf '\n\033[1;31mВнимание: по адресу %s сейчас открывается другая программа, а не студия.\033[0m\n' "$url"
           printf 'Выполните sudo tiktok-studio doctor — он покажет, что занимает адрес и как это исправить.\n' ;;
    none)  printf '\n\033[1;33mВнимание: адрес %s сейчас не отвечает. Проверка: sudo tiktok-studio doctor\033[0m\n' "$url" ;;
    nocert) printf '\n\033[1;33mСертификат HTTPS ещё не получен — подождите пару минут. Если не пройдёт: sudo tiktok-studio doctor\033[0m\n' ;;
    *) printf '\n\033[1;32mTikTok Studio работает.\033[0m\n' ;;
  esac
  printf '\n  Ссылка для телефона:  %s/?key=%s\n' "$url" "$key"
  printf '  Адрес:                %s\n' "$url"
  printf '  Код доступа:          %s\n\n' "$key"
  printf 'Откройте эту ссылку на телефоне — подойдёт любой интернет. Студию на компьютере\n'
  printf 'и кнопку 📱 в ней для этого не используйте: у сервера своя ссылка, туннель не нужен.\n\n'
  printf 'Отсканируйте QR-код камерой телефона:\n\n'
  py -c "import segno, sys; segno.make(sys.argv[1], error='m').terminal(compact=True)" "$url/?key=$key" || true
  cat <<'EOF'

Команды:
  sudo tiktok-studio info      показать ссылку, код и QR-код
  sudo tiktok-studio doctor    проверить, всё ли в порядке, и подсказать, что исправить
  sudo tiktok-studio update    обновить студию (видео и настройки сохранятся)
  sudo tiktok-studio restart   перезапустить
  sudo tiktok-studio logs      журнал работы
  sudo tiktok-studio new-key   сменить код доступа (все телефоны войдут заново)
EOF
}

doctor() {
  local url problems=0 code port holders line free_mb
  ok()  { printf '  \033[1;32m✔\033[0m %s\n' "$*"; }
  note() { printf '  \033[1;33m!\033[0m %s\n' "$*"; }
  bad() { printf '  \033[1;31m✖\033[0m %s\n' "$*"; problems=$((problems + 1)); }
  url="$(studio_url)"
  printf '\nПроверка TikTok Studio\n\n'

  if [ -d /run/systemd/system ]; then
    ok "обычный сервер с systemd"
  else
    bad "нет systemd — это контейнер или облачная среда, а не обычный VPS. Нужен VPS с чистой Ubuntu 24.04."
  fi

  if systemctl is-active --quiet tiktok-studio 2>/dev/null; then ok "служба студии работает"
  else bad "служба студии не работает → sudo tiktok-studio restart, причина — в sudo tiktok-studio logs"; fi

  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://127.0.0.1:$PORT/api/status" 2>/dev/null || true)"
  if [ "$code" = "401" ]; then ok "студия отвечает внутри сервера"
  else bad "студия не отвечает на 127.0.0.1:$PORT (код ${code:-000}) → sudo tiktok-studio logs"; fi

  if systemctl is-active --quiet caddy 2>/dev/null; then
    ok "веб-сервер Caddy работает"
  else
    bad "веб-сервер Caddy не работает. Последние строки его журнала:"
    journalctl -u caddy -n 8 --no-pager 2>/dev/null | sed 's/^/      /' || true
  fi

  holders="$(ports_report)"
  for port in 80 443; do
    if [ -z "$(port_pids "$port")" ]; then
      bad "порт $port никто не слушает (его должен слушать Caddy)"
    elif ! grep -q "порт $port:" <<<"$holders"; then
      ok "порт $port слушает Caddy"
    fi
  done
  if [ -n "$holders" ]; then
    bad "порты заняты другой программой — из-за неё по адресу сервера открывается не студия:"
    while read -r line; do printf '      %s\n' "$line"; done <<<"$holders"
    printf '      Если она не нужна: sudo tiktok-studio free-ports, затем sudo tiktok-studio restart\n'
  fi

  if [ -n "$url" ]; then
    case "$(url_state "$url")" in
      studio) ok "по ссылке $url открывается студия, сертификат HTTPS в порядке" ;;
      nocert) bad "студия по ссылке $url отвечает, но сертификата HTTPS нет: откройте в панели хостинга входящие TCP 80 и 443, затем sudo tiktok-studio restart" ;;
      other)  bad "по ссылке $url отвечает другая программа, а не студия. Если выше порты в порядке, адрес занят на стороне хостинга (например, шаблоном с Jupyter) — переустановите сервер на чистую Ubuntu 24.04" ;;
      none)   bad "ссылка $url не отвечает: откройте в панели хостинга входящие TCP 80 и 443" ;;
    esac
  else
    bad "студия не установлена до конца (нет $DATA_DIR/server.env) — запустите установку ещё раз"
  fi

  free_mb="$(df -Pm / | awk 'NR==2 {print $4}')"
  if [ "${free_mb:-0}" -ge 1000 ]; then ok "свободно на диске: ${free_mb} МБ"
  else bad "на диске осталось ${free_mb} МБ — удалите старые ролики в студии"; fi

  # Microsoft часто не отдаёт озвучку адресам серверов — тогда выручают голоса Piper.
  if py -c 'import pathlib, tempfile
from studio import tts
tts.edge_synthesize("Проверка связи.", "ru-RU-DmitryNeural", 0, 0, 0, pathlib.Path(tempfile.mkdtemp()) / "t.mp3", attempts=2)' >/dev/null 2>&1; then
    ok "озвучка Microsoft работает"
  elif py -c 'import sys; from studio import tts; sys.exit(0 if tts.piper_available() else 1)' >/dev/null 2>&1; then
    note "Microsoft не отдаёт озвучку этому серверу — ролики озвучиваются голосами Piper.
      Чтобы не ждать проверку каждый раз, выберите на вкладке «Голос» язык «Piper — без Microsoft»."
  else
    bad "Microsoft не отдаёт озвучку, а голосов Piper нет → sudo tiktok-studio update"
  fi

  if [ "$problems" -eq 0 ]; then
    printf '\nВсё в порядке. Если на телефоне ссылка всё равно не открывается — проверьте в панели\nхостинга, что открыты входящие TCP 80 и 443 (эта проверка идёт изнутри сервера).\n\n'
  else
    printf '\nНайдено проблем: %s. Исправьте их по подсказкам выше и запустите проверку ещё раз.\n\n' "$problems"
  fi
}

cmd="${1:-help}"
case "$cmd" in
  info) need_root "$cmd"; info ;;
  doctor|check) need_root "$cmd"; doctor ;;
  ports) need_root "$cmd"; ports_report ;;
  free-ports)
    need_root "$cmd"
    free_ports
    if [ -n "$(port_holders)" ]; then
      printf 'Порты 80/443 по-прежнему заняты:\n%s\n' "$(ports_report)" >&2
      exit 1
    fi ;;
  update) need_root "$cmd"; shift; curl -fsSL "$INSTALLER" | bash -s -- "$@" ;;
  restart) need_root "$cmd"; systemctl restart tiktok-studio; systemctl restart caddy 2>/dev/null || true; echo "Перезапущено." ;;
  logs) need_root "$cmd"; journalctl -u tiktok-studio -n "${2:-100}" --no-pager ;;
  status) need_root "$cmd"; systemctl --no-pager status tiktok-studio caddy | head -40 ;;
  new-key)
    need_root "$cmd"
    py -c "from studio import config, phone; config.save_settings({'phone_key': ''}); phone.access_key()"
    systemctl restart tiktok-studio
    info ;;
  help|-h|--help)
    cat <<'EOF'
Команды:
  sudo tiktok-studio info      показать ссылку, код и QR-код
  sudo tiktok-studio doctor    проверить, всё ли в порядке, и подсказать, что исправить
  sudo tiktok-studio update    обновить студию (видео и настройки сохранятся);
                               update --free-ports — заодно освободить порты 80 и 443
  sudo tiktok-studio restart   перезапустить
  sudo tiktok-studio logs      журнал работы (logs 300 — последние 300 строк)
  sudo tiktok-studio status    состояние служб
  sudo tiktok-studio new-key   сменить код доступа (все телефоны войдут заново)
  sudo tiktok-studio ports     кто занимает порты 80 и 443
  sudo tiktok-studio free-ports  остановить чужие программы на портах 80 и 443
EOF
    ;;
  *) die "неизвестная команда «$cmd». Справка: sudo tiktok-studio help" ;;
esac
